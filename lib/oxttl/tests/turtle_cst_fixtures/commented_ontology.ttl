@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <http://example.com/ont#> .

# Top-level classes in the example ontology.

ex:Animal a owl:Class ;
    rdfs:label "Animal" ;
    rdfs:comment "Any living organism in the kingdom Animalia." .

# Mammals are a subclass of Animal.
ex:Mammal a owl:Class ;
    rdfs:subClassOf ex:Animal ;
    rdfs:label "Mammal" .

# Dogs are mammals.
ex:Dog a owl:Class ;
    rdfs:subClassOf ex:Mammal ;
    rdfs:label "Dog" .
